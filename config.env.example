# PT Media Manager configuration. Template only: ./up.sh copies it to
# ~/.config/ptmm/config.env on first run (or $PTMM_CONFIG_DIR/config.env if
# that is set in the environment); edit that copy, not this file. The same
# directory holds the database and its backups, so it is all there is to back
# up.

# Required
TMDB_API_KEY=replace-with-your-tmdb-read-access-token
# Mount point of the disk holding both the downloads and the library, e.g.
# /media/h16t0 for /media/h16t0/PT/... -> /media/h16t0/Lib/... — hard links
# only work within one disk, and within one container mount.
MEDIA_DISK_MOUNT=/media/h16t0

# Directory holding the TLS certificate and key, mounted read-only. Renewals
# are picked up automatically (checked every CERT_RELOAD_INTERVAL seconds).
CERT_DIR=/etc/nginx/certs/example.com
CERT_FULLCHAIN_FILE=fullchain.pem
CERT_KEY_FILE=privkey.pem
# CERT_RELOAD_INTERVAL=3600

HTTPS_PORT=8443
# Backend port, bound to 127.0.0.1 on the host for nginx only. Change it if
# something else already uses 8000.
# BACKEND_PORT=8000

# Optional. up.sh defaults these to the invoking user (SUDO_UID/SUDO_GID under sudo).
# PUID=1000
# PGID=1000
UMASK=002

# Authentication. Generate the hash and secret with ./gen-auth.sh and paste
# its output here — keep the single quotes around the hash, otherwise Compose
# expands the $ signs in it and logins fail.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=
